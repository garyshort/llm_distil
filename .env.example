# Copy this file to .env and fill in your values.
# OPENAI_API_KEY is required.
# For Azure OpenAI: set OPENAI_BASE_URL to your Azure endpoint and optionally OPENAI_API_VERSION.
# Omit OPENAI_BASE_URL to use the default OpenAI API (api.openai.com).
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://your-resource.openai.azure.com/
OPENAI_API_VERSION=2024-12-01-preview
OPENAI_MODEL=gpt-4o-mini

# Demo4: Azure ML job submission (submit_job.py)
AZURE_SUBSCRIPTION_ID=your-subscription-id
AZURE_RESOURCE_GROUP=your-resource-group
AZUREML_WORKSPACE_NAME=your-workspace-name

# gpt54-endpoint (Azure Cognitive Services)
GPT54_ENDPOINT_API_KEY=your-gpt54-api-key-here
GPT54_ENDPOINT_BASE_URL=https://your-resource.cognitiveservices.azure.com/
GPT54_ENDPOINT_API_VERSION=2024-12-01-preview
GPT54_ENDPOINT_MODEL=your_gpt54_deployment_name

# Demo5 uses GPT54_ENDPOINT_* above (or OPENAI_* with --use-openai-endpoint).
# Public images are downloaded from the Oxford-IIIT Pet Dataset; no Azure Storage required.
